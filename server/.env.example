# ---- Server ----
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (free tier works).
# Leave empty to use the built-in in-memory database (data resets on restart).
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/mern_todo?retryWrites=true&w=majority

# Secret used to sign login tokens — use a long random string in production.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: extra allowed frontend origins (comma separated)
CLIENT_ORIGIN=http://localhost:5173
